{
  "name": "qice-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 43123 --ip 127.0.0.1",
    "start": "wrangler dev --port 43123 --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generate-fixtures.mjs && vitest run",
    "test:unit": "node scripts/generate-fixtures.mjs && vitest run",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "seed:sql": "node scripts/gen-seed.mjs",
    "db:migrate": "wrangler d1 migrations apply qice-ai --local",
    "create-admin": "node scripts/create-admin.mjs",
    "cf-typegen": "wrangler types",
    "test:e2e": "playwright test",
    "deploy": "echo '不要在未确认前部署。请先阅读 README。' && exit 1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "heic2any": "^0.0.4",
    "hono": "^4.8.4",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  }
}
